#tag WindowCode
	#tag Event
		Sub Opening()
		  InitializeWindow
		  
		  Return
		  
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h0
		Sub AddCurrent()
		   
		  var row as integer = Self.RowTagCounter + 1
		  self.RowTagCounter = row
		  
		  
		  ListBox1.AddRow("")
		  var idx as integer = Listbox1.LastAddedRowIndex
		  
		  for i  as integer = 0 to 2
		    Listbox1.CellTextAt(idx, i) =  TextField1(i).Text.Trim()
		    TextField1(i).Text = ""
		    
		  next
		  
		  Listbox1.RowTagAt(idx) = row
		  
		  Return
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub EndUpdate()
		  
		  Return
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub ExecuteButtonAction(Action as ButtonTags)
		  
		  
		  select case Action
		    
		  case ButtonTags.AddCurrent
		    if ValidInputForNew() then 
		      AddCurrent
		      RestoreButtonDefault
		      
		    else
		      
		    end if
		    
		  case ButtonTags.UpdateFromCurrent
		    if ValidInputForUpdate() then 
		      UpdateFromCurrent
		      EndUpdate
		      RestoreButtonDefault
		      
		    else
		      
		    end if
		    
		  case ButtonTags.NoAction
		    
		  case ButtonTags.CancelCurrentAction
		    RestoreButtonDefault
		    
		  case ButtonTags.PrepareToAdd
		    PrepareToAdd
		    
		  case else
		    
		  end Select
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub InitializeWindow()
		  
		  self.RowTagCounter = 0
		  
		  ListBox1.ColumnCount = 3
		  
		  Listbox1.HasHeader = True
		  
		  for i  as integer =0 to 2
		    ListBox1.HeaderAt(i) = Label1(I).Text
		    
		  next
		  
		  RestoreButtonDefault
		  
		  Return
		  
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub PrepareToAdd()
		  self.SelectedRowID = -1
		  
		  btn_update.Caption = "Add"
		  btn_delete.Caption = "Cancel"
		  
		  btn_update.Tag = ButtonTags.AddCurrent
		  btn_delete.Tag =  ButtonTags.CancelCurrentAction
		  
		  btn_New.Enabled = False
		  btn_update.Enabled = True
		  btn_delete.Enabled = True
		  
		  TextField1(0).Enabled  = True
		  TextField1(1).Enabled  = True
		  TextField1(2).Enabled  = True
		  
		  TextField1(0).SetFocus
		  
		  Return
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub PrepateToUpdate(selectedRowIndex as integer)
		  
		  var selectedRowTag as integer = Listbox1.RowTagAt(selectedRowIndex)
		  self.SelectedRowID = selectedRowTag
		  
		  btn_update.Caption = "Update"
		  btn_delete.Caption = "Cancel"
		  
		  for i  as integer = 0 to 2
		    TextField1(i).Text = Listbox1.CellTextAt(selectedRowIndex, i) 
		    TextField1(i).Enabled  = True
		    
		  next
		  
		  TextField1(0).SetFocus
		  
		  btn_update.Tag = ButtonTags.UpdateFromCurrent
		  btn_delete.Tag =  ButtonTags.CancelCurrentAction
		  
		  btn_New.Enabled = False
		  btn_update.Enabled = True
		  btn_delete.Enabled = True
		  
		  Return
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub RestoreButtonDefault()
		  btn_New.Caption = "New"
		  btn_update.Caption = "Update"
		  btn_delete.Caption = "Delete"
		  
		  btn_new.Tag = ButtonTags.PrepareToAdd
		  btn_update.Tag = ButtonTags.NoAction
		  btn_delete .Tag = ButtonTags.NoAction
		  
		  btn_New.Enabled = True
		  btn_update.Enabled = false
		  btn_delete.Enabled = false
		  
		  for i  as integer = 0 to 2
		    TextField1(i).Enabled  = false
		    TextField1(i).Text = ""
		    
		  next
		  
		  self.SelectedRowID = -1
		  
		  Return
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub UpdateFromCurrent()
		  
		  //
		  // locate row to update 
		  //
		  
		  var selectedRowIndex as integer = -1
		  
		  for i as integer = 0 to listbox1.LastRowIndex
		    if Listbox1.RowTagAt(i) = self.SelectedRowID then
		      selectedRowIndex = i
		      
		    end if
		    
		  next
		  
		  if selectedRowIndex < 0 then Return
		  
		  for i  as integer = 0 to 2
		    Listbox1.CellTextAt(selectedRowIndex, i) =  TextField1(i).Text.Trim()
		    TextField1(i).Text = ""
		    
		  next
		  
		  return
		  
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Function ValidInputForNew() As Boolean
		  
		  Return True
		  
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Function ValidInputForUpdate() As Boolean
		  
		  Return True
		  
		End Function
	#tag EndMethod


	#tag Property, Flags = &h0
		Shared RowTagCounter As Integer
	#tag EndProperty

	#tag Property, Flags = &h0
		SelectedRowID As Integer
	#tag EndProperty


	#tag Enum, Name = ButtonTags, Type = Integer, Flags = &h0
		AddCurrent
		  UpdateFromCurrent
		  NoAction
		  CancelCurrentAction
		PrepareToAdd
	#tag EndEnum


#tag EndWindowCode

#tag Events ListBox1
	#tag Event
		Function CellPressed(row As Integer, column As Integer, x As Integer, y As Integer) As Boolean
		   
		  if row < 0 then Return false
		  if row > Listbox1.LastRowIndex then return False
		  
		  PrepateToUpdate row
		  
		  return true
		  
		End Function
	#tag EndEvent
#tag EndEvents
#tag Events btn_New
	#tag Event
		Sub Pressed()
		  
		  ExecuteButtonAction me.Tag
		  
		  Return
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btn_update
	#tag Event
		Sub Pressed()
		  
		  ExecuteButtonAction me.Tag
		  
		  Return
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btn_delete
	#tag Event
		Sub Pressed()
		  
		  ExecuteButtonAction me.Tag
		  
		End Sub
	#tag EndEvent
#tag EndEvents
