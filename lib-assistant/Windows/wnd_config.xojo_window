#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Opening()
		  
		  self.cfg  = app.GetConfiguration.Clone
		  
		  
		  tf_basepath.Text  = cfg.XojoFolderBase
		  tf_default_author.Text = cfg.DefaultAuthor
		  
		  
		End Sub
	#tag EndEvent


	#tag Property, Flags = &h0
		cfg As clXojoSCAConfiguration
	#tag EndProperty


#tag EndWindowCode

#tag Events btn_save
	#tag Event
		Sub Pressed()
		  
		  app.GetConfiguration.UpdateFrom(self.cfg)
		  app.GetConfiguration.Save()
		  
		  self.Close
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Button1
	#tag Event
		Sub Pressed()
		  
		  Var f As FolderItem = FolderItem.ShowSelectFolderDialog
		  
		  if f=nil then Return
		  
		  tf_basepath.Text = f.NativePath
		  self.cfg.XojoFolderBase = f.NativePath
		  
		  Return
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events tf_default_author
	#tag Event
		Sub TextChanged()
		  
		  var temp as string = tf_default_author.text.trim
		  
		  if temp = cfg.DefaultAuthor then Return
		  
		  cfg.DefaultAuthor = temp
		  
		  Return
		  
		End Sub
	#tag EndEvent
#tag EndEvents
